# Copy to .env for local development. In production every secret below is REQUIRED,
# must be at least 24 characters, and must be different from the others.
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=3000
NODE_ENV=development
# Optional custom SQLite database file path (defaults to ./data/agentshield.db)
# AGENTSHIELD_DB_PATH=./data/agentshield.db

# Signs agent delegation JWTs (HS256)
AGENTSHIELD_JWT_SECRET=
# Signs every audit-log entry and external audit anchor (kept separate from JWT secret)
AGENTSHIELD_AUDIT_HMAC_KEY=
# Shared secret the gateway presents to the bank API (x-bank-internal-secret)
BANK_INTERNAL_SECRET=
# Optional separate key for signing short-lived (30s TTL) gateway -> bank execution auth tokens
# AGENTSHIELD_BANK_AUTH_KEY=
# Signs customer / admin session cookies
SESSION_SECRET=
# Independent per-transaction bank ceiling in rupees (defense-in-depth default: 100000)
BANK_MAX_TXN_RUPEES=100000

# Demo shortcuts (preview customer session, role switch, reset, tamper button, Attack Lab).
# Defaults to true outside production and false in production. Leave false when deployed.
DEMO_MODE=true
# Trust the IP an agent declares in its fingerprint (demo agents run on localhost).
# Defaults to the value of DEMO_MODE. In production the gateway uses the connection address.
# TRUST_CLIENT_FINGERPRINT=false
# Behind a load balancer set the number of proxy hops so req.ip is the real client address.
# TRUST_PROXY=1

# Optional: lets the Live BillPay agent (and Stage 3b semantic judge) call Anthropic or Gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# First production start only (empty DB): creates the single bank admin. Remove afterwards.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=   # min 12 chars
